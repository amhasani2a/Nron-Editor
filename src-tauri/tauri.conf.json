{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nron Editor",
  "version": "1.0.0",
  "identifier": "com.nron.editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nron Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Fast offline RTL writing studio",
    "longDescription": "Nron Editor is a fast, offline-first writing studio with a Rust core, full RTL support, versioned history, and multi-format export."
  },
  "plugins": {}
}
